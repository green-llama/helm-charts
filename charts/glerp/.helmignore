# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Human-facing documentation — versioned on GitHub, NOT bundled into the chart .tgz
# (adds weight, never used at render/runtime). README/questions/app-readme are kept
# on purpose so Rancher/catalog rendering still works.
docs/
CHANGELOG.md
TENANT.md
